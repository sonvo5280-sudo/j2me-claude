# Server port (AI Studio uses 3000)
PORT=3000

# MIDP core to use: microemu | own
CORE=microemu

# Maximum concurrent J2ME sessions
MAX_SESSIONS=5

# Allow game network access (1 to enable, 0 to disable)
ALLOW_NET=1

# HTTP Basic Auth password for username "admin" (recommended when public)
APP_PASSWORD=

# Optional directory overrides
# GAMES_DIR=./games
# DATA_DIR=./data

# Optional logging and build flags
# VERBOSE=1
# REBUILD_WEB=1
